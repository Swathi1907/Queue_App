<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Avatar, Name, Specialization, Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoctorAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground"
                app:shapeAppearanceOverlay="@drawable/wait_time" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvDoctorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Robert Chen"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545" />

                <TextView
                    android:id="@+id/tvSpecialization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardiology"
                    android:textSize="12sp"
                    android:textColor="#6C757D" />
            </LinearLayout>

            <!-- Status Pill Badge -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Active"
                android:textSize="11sp"
                android:textColor="#137547"
                android:background="@drawable/bg_status_active"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Middle Content Box (Queue Details or Next Shift) -->
        <LinearLayout
            android:id="@+id/layoutQueueInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F8F9FA"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLabelLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT QUEUE"
                    android:textSize="10sp"
                    android:textColor="#8D99AE"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvValueLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 Patients"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLabelRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EST. WAIT"
                    android:textSize="10sp"
                    android:textColor="#8D99AE"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvValueRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45 mins"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0B2545"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Action Row: Action Button & Edit Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnActionQueue"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="View Queue"
                android:textColor="#0B2545"
                app:strokeColor="#CED4DA"
                app:cornerRadius="10dp"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnEditDoctor"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_edit_button"
                android:src="@drawable/outline_edit_24"
                app:tint="#0B2545"
                android:contentDescription="Edit Doctor" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>