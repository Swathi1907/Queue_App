<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- ================= HEADER ================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#005B4F"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <!-- Top row -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE QUEUE TICKET"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                </LinearLayout>


                <!-- Live tracking indicator -->


            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================= CONTENT ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp">


            <!-- ================= HOSPITAL / DOCTOR ================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5EEEC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Hospital image -->

                    <ImageView
                        android:id="@+id/imgHospital"
                        android:layout_width="58dp"
                        android:layout_height="58dp"

                        android:contentDescription="Hospital"
                        android:padding="8dp"
                        android:scaleType="centerCrop"
                         />

                    <!-- Details -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHospitalName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="APOLLO HOSPITAL"
                            android:textColor="#00796B"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDoctor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Dr. Jacob Howard"
                            android:textColor="#183B47"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDepartment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Emergency Department"
                            android:textColor="#65757E"
                            android:textSize="11sp" />


                    </LinearLayout>


                    <!-- Doctor availability -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDoctorAvailability"
                        android:layout_width="58dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="#EFFFF7"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#B9EED9"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_status_green" />

                            <TextView
                                android:id="@+id/tvDoctorAvailability"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="On Duty"
                                android:textColor="#00866D"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= TOKEN ================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="YOUR TOKEN"
                        android:textColor="#778990"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTokenNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="27"
                        android:textColor="#10B5B3"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <!-- Status pill -->

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_status_waiting"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="●  WAITING"
                        android:textColor="#D79500"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Message -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="#F1FAF9"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvQueueMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You are next! Please proceed near Room 04"
                            android:textColor="#247A76"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================= QUEUE INFORMATION ================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Title -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Queue Information"
                            android:textColor="#193C48"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvQueueReference"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live Queue"
                            android:textColor="#8795A0"
                            android:textSize="9sp" />

                    </LinearLayout>


                    <!-- People Ahead -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="People Ahead"
                            android:textColor="#687B84"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPeopleAhead"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="0 people"
                            android:textColor="#183B47"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- Estimated Wait -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Estimated Wait"
                            android:textColor="#687B84"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvEstimatedWait"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="1 min"
                            android:textColor="#00866D"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- Queue Date -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Queue Date"
                            android:textColor="#687B84"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvQueueDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21 Sep 2026"
                            android:textColor="#183B47"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- Payment -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Payment"
                            android:textColor="#687B84"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPaymentStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_green"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="✓ Paid"
                            android:textColor="#00866D"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <!-- ================= USER NOTES ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@android:color/white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Notes"
                    android:textColor="#193C48"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No notes added"
                    android:textColor="#687B84"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ================= LEAVE QUEUE ================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeaveQueue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="⇥  Leave Queue"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="#EF4444"
                app:strokeWidth="1dp" />


            <!-- ================= HELP ================= -->



        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>