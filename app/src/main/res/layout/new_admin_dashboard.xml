<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card 1: Active Queues -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/labelActiveQueues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Queues"
                    android:textColor="#495057"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvActiveQueues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/labelActiveQueues"
                    android:layout_marginTop="12dp"
                    android:text="12  ↑ +2"
                    android:textColor="#0B2545"
                    android:textSize="22sp"
                    android:textStyle="bold" />


            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 2: Doctors on Duty -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/labelDoctors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Doctors on Duty"
                    android:textColor="#495057"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDoctorsOnDuty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/labelDoctors"
                    android:layout_marginTop="12dp"
                    android:text="45 / 50 total"
                    android:textColor="#0B2545"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 3: Patients Waiting -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/labelPatients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patients Waiting"
                    android:textColor="#495057"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPatientsWaiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/labelPatients"
                    android:layout_marginTop="12dp"
                    android:text="128  ↑ High Load"
                    android:textColor="#D32F2F"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick Actions Section Title -->


        <!-- Action Button 1 -->


        <!-- Action Button 2 -->

        <!-- Recent Activity Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent Activity"
                android:textColor="#0B2545"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View All"
                android:textColor="#134074"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recent Activity Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:id="@+id/notificationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />

        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>