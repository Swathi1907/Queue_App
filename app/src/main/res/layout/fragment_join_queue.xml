<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F8F9FA"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header / Doctor Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_green"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgDoctor"
                android:layout_width="60dp"
                android:layout_height="60dp"
               />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDoctorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Emilia Emelson"
                    android:textColor="#0B2545"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpecialty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Practice"
                    android:textColor="#6C757D"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvWaitTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 Current Wait: ~45 mins"
                    android:textColor="#134074"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Symptoms Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What are your symptoms?"
            android:textColor="#0B2545"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Providing this helps the doctor prepare for your visit. (Optional)"
            android:textColor="#6C757D"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSymptoms"
            android:layout_width="match_parent"
            android:layout_height="120dp"

            android:gravity="top|start"
            android:hint="Briefly describe what you're experiencing..."
            android:padding="12dp"
            android:textColor="#0B2545"
            android:textSize="14sp" />

        <!-- Preferred Arrival Time -->


        <!-- Time Slot Chips Grid (Horizontal / Flow) -->


        <!-- QR Code Placeholder Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"

            android:gravity="center"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You'll receive a QR code here once your spot is confirmed."
                android:textColor="#6C757D"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="24dp" />
        </LinearLayout>

        <!-- Confirm & Join Queue Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmJoin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_chip_light_green"
            app:backgroundTint="@null"
            android:text="Confirm &amp; Join Queue →"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>