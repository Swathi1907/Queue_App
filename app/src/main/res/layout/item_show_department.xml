<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"

            app:tint="#005B5C"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvDepartmentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cardiology"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#212529"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Waiting info layout containing the icon and count text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/outline_diversity_3_24"
                app:tint="#005B5C"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tvWaitingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 waiting"
                android:textSize="16sp"
                android:textColor="#005B5C" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>